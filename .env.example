# Windows 로컬 개발 시작: Copy-Item .env.example .env
# 아래 예시를 복사한 뒤 환경에 맞게 작성하세요.
# 실제 비밀번호, API 키 등 비밀값과 .env 파일은 절대 commit하지 마세요.

DJANGO_DEBUG=true
# 필수 변경: 로컬에서도 예시값을 그대로 사용하지 말고 충분히 긴 임의의 값으로 바꾸세요.
DJANGO_SECRET_KEY=change-me-only-in-your-local-env
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_LOG_LEVEL=INFO
DEFAULT_FROM_EMAIL=no-reply@example.test
# 로컬 개발용입니다. 운영에서는 실제 발송 backend와 SMTP 값을 사용해야 합니다.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_EMAIL_REQUEST_LIMIT=5
OTP_IP_REQUEST_LIMIT=20
USER_SEARCH_MIN_LENGTH=2
USER_SEARCH_PAGE_SIZE=20
USER_SEARCH_MAX_PAGE_SIZE=50
# 확정 전에는 비워 둡니다. 예: {"student":"editor","tutor":"tutor"}
PARENT_ROLE_PARTICIPANT_MAP={}
PARENT_STAFF_PARTICIPANT_ROLE=
PARENT_SUPERUSER_PARTICIPANT_ROLE=

POSTGRES_DB=idea_developer
POSTGRES_USER=idea_developer
# 필수 변경: 로컬 PostgreSQL에 설정한 실제 비밀번호로 바꾸세요.
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_OPTIONS=-c search_path=idea_developer,public

# 부모가 제공한 읽기 전용 PostgreSQL VIEW DB 접속값입니다.
# public.ax_user_team_login_view와 public.user_round_team_view만 읽기 전용으로 조회하며 VIEW를 생성하거나 INSERT/UPDATE/DELETE하지 않습니다.
# 10.2.16.91:8000은 부모 웹서비스 주소입니다. DB 호스트에는 10.2.16.91만, 포트에는 5432를 사용합니다.
INTEGRATION_DB_NAME=ax_evaluation
INTEGRATION_DB_USER=ax_evaluation
# 안전한 placeholder입니다. 실제 비밀번호는 개인 .env에만 입력하고 commit하지 마세요.
INTEGRATION_DB_PASSWORD=change-me
INTEGRATION_DB_HOST=10.2.16.91
INTEGRATION_DB_PORT=5432
INTEGRATION_DB_CONN_MAX_AGE=0
INTEGRATION_DB_CONNECT_TIMEOUT=2
INTEGRATION_DB_OPTIONS=-c default_transaction_read_only=on -c search_path=public
INTEGRATION_DB_ALIAS=integration
# 부모 EvaluationRound에서 확인한 실제 진행 중 상태값입니다.
INTEGRATION_ACTIVE_ROUND_STATUSES=IN_PROGRESS
INTEGRATION_APPROVED_USER_STATUS=approved
INTEGRATION_CONTEXT_RESOLVER_CLASS=apps.integration.context.StandaloneSessionContextResolver
# 개발 중 부모 VIEW DB가 끊기면 config/settings/development.py의 임시 사용자를 사용합니다.
# 운영 설정에서는 이 값과 관계없이 fixture fallback이 활성화되지 않습니다.
DEV_INTEGRATION_FALLBACK=true

# 부모 CSP 이관 시 script-src에 CDN origin을 반영합니다.
CSP_SCRIPT_SRC='self',https://cdn.jsdelivr.net

POLLING_INTERVAL_MS=3000
POLLING_MIN_INTERVAL_MS=2000
POLLING_MAX_INTERVAL_MS=5000
JOB_WORKER_POLL_SECONDS=5
JOB_RUNNER_CLASS=apps.ai.worker.AiJobRunner

# 선택 사항: Gemini 기능을 사용할 때만 API 키를 개인 .env 또는 배포 비밀 저장소에 설정하세요.
# 실제 Gemini API 키는 이 파일이나 git에 commit하지 마세요.
AI_PROVIDER_CLASS=apps.ai.gemini.GeminiAiProvider
GEMINI_API_KEY=
# 개발 중 Gemini 키가 없을 때 PRD 충족도 샘플 결과를 즉시 생성·캐시합니다.
# 키를 입력하면 development 설정에서도 실제 Gemini 호출로 자동 전환됩니다.
AI_EVALUATION_DEMO_CACHE=true
AI_RESULT_PROCESSOR_CLASS=apps.ai.brainstorm.BrainstormAiResultRouter
AI_JOB_TIMEOUT_SECONDS=30
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_SECONDS=5
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_TOKEN_LIMIT=200000
AI_DAILY_COST_LIMIT_USD=20.00
AI_DUPLICATE_WINDOW_SECONDS=10
AI_CHAT_MESSAGE_MAX_LENGTH=4000
AI_CONTEXT_MAX_CHARS=20000
AI_RESPONSE_MAX_LENGTH=12000
AI_DRAFT_MAX_LENGTH=12000
AI_TTL_DELETE_BATCH_SIZE=500
AI_PREVIEW_RETENTION_DAYS=7
AI_CHAT_PAYLOAD_RETENTION_DAYS=30
BACKGROUND_CLEANUP_BATCH_SIZE=500
BACKGROUND_CLEANUP_INTERVAL_SECONDS=86400
BRAINSTORM_DELETE_RETENTION_DAYS=30
PRD_TRASH_RETENTION_DAYS=30
AI_BRAINSTORM_MAX_NODES=500
AI_BRAINSTORM_MAX_CHARS=50000
AI_CONTRIBUTION_MAX_COMMENTS=500
AI_CONTRIBUTION_MAX_CHARS=50000
BRAINSTORM_NOTE_MAX_LENGTH=4000
BRAINSTORM_ALLOWED_COLORS=yellow,blue,gray,green,pink,purple,orange

# 운영 환경에서만 필요에 따라 설정합니다.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
